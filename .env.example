# YouTube→Telegram Summarizer Bot Configuration
# Copy this file to .env and fill in your credentials

# ============================================
# REQUIRED: API Credentials
# ============================================

# Google Gemini API (for video summarization)
# Get free API key at: https://ai.google.dev/tutorials/setup
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot Token (for posting digests)
# Create a bot via BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram Chat ID (group where digest is posted)
# Default: -1002007708028 (update if needed)
TELEGRAM_CHAT_ID=-1002007708028

# Telegram API Credentials (for reading channel posts)
# Get at: https://my.telegram.org/apps
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
TELEGRAM_PHONE=+1234567890

# ============================================
# Optional: Configuration
# ============================================

# State file location (tracks seen videos)
STATE_FILE=state.json

# Telethon session file (stores Telegram authentication)
TELETHON_SESSION_FILE=telethon_session.session

# Enable debug logging (verbose output)
DEBUG=false
