{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "victoria-neiman-website (Next.js dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "victoria-neiman-website", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "summaries-report",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 -m http.server \"$PORT\""],
      "port": 8765,
      "autoPort": true
    }
  ]
}
